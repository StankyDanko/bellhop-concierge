{
  "name": "bellhop-concierge",
  "version": "0.1.0",
  "private": true,
  "description": "Bellhop Concierge: a phone concierge for small inns. Tool server and agent compiler for a voice agent, powered by the Qloo taste graph and Ticketmaster.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "/usr/bin/node server/index.js",
    "dev": "/usr/bin/node --watch server/index.js",
    "mock": "QLOO_MOCK=1 TICKETMASTER_MOCK=1 CONCIERGE_TOOL_SECRET=${CONCIERGE_TOOL_SECRET:-local-dev-secret-change-me} /usr/bin/node server/index.js",
    "test": "/usr/bin/node --test server/ compiler/",
    "live": "/usr/bin/node --env-file=server/.env server/index.js",
    "probe:qloo": "/usr/bin/node --env-file=server/.env server/scripts/probe-qloo.js",
    "compile": "/usr/bin/node bin/compile.js",
    "schema": "/usr/bin/node bin/compile.js --print-schema > config/schema.json",
    "build:dashboard": "vite build --config dashboard/vite.config.js && /usr/bin/node dashboard/scripts/build-legal.mjs",
    "dev:dashboard": "vite --config dashboard/vite.config.js",
    "smoke:dashboard": "/usr/bin/node dashboard/scripts/smoke.mjs",
    "hooks": "git config core.hooksPath scripts/githooks"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.3"
  }
}
