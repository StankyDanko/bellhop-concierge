{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StankyDanko/bellhop-concierge/config/schema.json",
  "title": "Bellhop Concierge host config",
  "description": "One property. Produced by the host intake (Q0 to Q11), read by the compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "property",
    "voice",
    "guests",
    "logistics",
    "rules",
    "picks",
    "avoid",
    "faq",
    "handoff",
    "permissions",
    "trust_level"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "property": {
      "description": "Q0 and Q1. Where the inn is. The address and website are never spoken.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "lat",
        "lng",
        "timezone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA zone, for example America/New_York"
        },
        "website": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^https://"
        }
      }
    },
    "voice": {
      "description": "Q1 feel and Q3 voice. humor_level: 0 none, 1 one dry beat per call, 2 light and warm.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_id",
        "humor_level",
        "languages"
      ],
      "properties": {
        "persona_id": {
          "type": "string",
          "enum": [
            "harper",
            "maybelle"
          ]
        },
        "humor_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "feel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Q1: the feeling the host wants guests to have"
        }
      }
    },
    "guests": {
      "description": "Q2. Who stays, and what they come for.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typical",
        "here_for"
      ],
      "properties": {
        "typical": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "here_for": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "logistics": {
      "description": "Q4 and Q5. access_note and wifi_note are SECRET: never compiled into anything the agent can say.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkin",
        "checkout"
      ],
      "properties": {
        "checkin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "checkout": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "parking": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "access_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "SMS-only. Door, lockbox, gate details."
        },
        "wifi_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "SMS-only. Network and password."
        }
      }
    },
    "rules": {
      "description": "Q6. House rules; never_bend are the ones with no exceptions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list",
        "never_bend"
      ],
      "properties": {
        "list": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "never_bend": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "picks": {
      "description": "Q7. The host's own favorites, quoted to guests with the host's reason.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "why",
          "category"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "enum": [
              "food",
              "drinks",
              "music",
              "outdoors",
              "arts",
              "shopping",
              "coffee",
              "other"
            ]
          },
          "partner": {
            "type": "boolean",
            "description": "A business the inn has an arrangement with"
          }
        }
      }
    },
    "avoid": {
      "description": "Q8. Never recommended, never mentioned.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "faq": {
      "description": "Q9. The questions guests ask most, at most five.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    },
    "handoff": {
      "description": "Q10. Who a guest is sent to, and when. The full phone number never enters this config.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "triggers",
        "hours"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "phone_last4": {
          "type": "string",
          "pattern": "^[0-9]{4}$",
          "description": "For the host dashboard only; never compiled"
        },
        "triggers": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "hours": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "permissions": {
      "description": "Q11. What the concierge may do on its own.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "send_itinerary_sms",
        "suggest_partners",
        "upsell"
      ],
      "properties": {
        "send_itinerary_sms": {
          "type": "boolean"
        },
        "suggest_partners": {
          "type": "boolean"
        },
        "upsell": {
          "type": "boolean"
        }
      }
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "test",
        "suggest",
        "live"
      ]
    }
  }
}
